{
  "name": "snhs-smart-poster-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Intelligent non-destructive poster automation for Adobe Photoshop (ExtendScript + COM + VBS)",
  "main": "electron-v2/main.js",
  "scripts": {
    "dev": "npm run v2:build && electron electron-v2/main.js",
    "build": "node scripts/build.mjs --v2",
    "package": "npm run build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node scripts/build.mjs --clean",
    "desktop:compile": "node scripts/build.mjs --electron",
    "desktop:dev": "node scripts/build.mjs && node scripts/build.mjs --electron && npx electron electron/main.js",
    "desktop:build": "node scripts/build.mjs && node scripts/build.mjs --electron",
    "desktop:package": "npm run desktop:build && npx electron-builder --win --x64",
    "desktop:installer": "npm run desktop:package",
    "v2:build": "node scripts/build.mjs --v2",
    "v2:dev": "npm run v2:build && electron electron-v2/main.js"
  },
  "build": {
    "appId": "com.snhs.poster-agent",
    "productName": "SNHS SMART POSTER AGENT V2",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-v2/**/*",
      "electron-v2/**/*",
      "src-v2/**/*",
      "photoshop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "photoshop",
        "to": "photoshop",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SNHS SMART POSTER AGENT V2"
    }
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
